[MASTER]
# Tell pylint these are valid third‑party packages
extension-pkg-allow-list=
    boto3,
    botocore,
    urllib3,
    yaml

[TYPECHECK]
# Skip strict type checking for these modules
ignored-modules=
    boto3,
    botocore,
    botocore.config,
    boto3.s3.transfer,
    urllib3,
    yaml

[FORMAT]
# s3mirror is deliberately a single script, so it's allowed past pylint's default of 1000 lines.
max-module-lines=1500
