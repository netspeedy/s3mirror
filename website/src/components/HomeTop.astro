---
// The top of the home page: the title and lead on the left, and on the right a dark panel with a
// copy-only run and part of what it printed, the config it ran with, and the commands for a
// scheduled run. The output is real: s3mirror printed it for this config, run against an
// in-process fake of the two endpoints rather than real S3, which is why the transfers are tiny.
// It's an excerpt, and the comment lines say where it was cut. Keep it in step with the
// quickstart, which shows the same run in full.
import { links, product, release } from "../lib/site";

const { title } = Astro.locals.starlightRoute.entry.data;
// "No vendor lock-in. Copy what changed." goes on two lines.
const lines = title.split(/(?<=\.)\s+/);

const esc = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
const span = (cls: string, text: string) => `<span class="${cls}">${esc(text)}</span>`;

/** One shell line: the command, flags, arguments and a trailing line continuation. */
function shell(line: string, first: boolean): string {
  let command = first;
  const words = line.split(/( +)/).map((word) => {
    if (!word.trim()) return word;
    if (word === "\\") return span("m", word);
    if (command) {
      command = false;
      return span("c", word);
    }
    return span(word.startsWith("-") ? "f" : "v", word);
  });
  return (first ? span("p", "$ ") : "") + words.join("");
}
const commandLines = (lines: string[]) => lines.map((line, i) => shell(line, i === 0));
const join = (commands: string[]) => commands.map((line) => line.replace(/^ +/, "  ")).join("\n");

/** A line of s3mirror's console output: rules muted, the bucket named, marks and sizes coloured. */
function output(line: string): string {
  // The 70-column rules are clipped to the panel rather than scrolling it (see .rule below).
  if (/^=+$/.test(line)) return span("rule", line);
  const bucket = line.match(/^(\[\d+\/\d+\]: )(.*)$/);
  if (bucket) return span("m", bucket[1]) + span("h", bucket[2]);
  const marks: Record<string, string> = { "✓": "y", "⚠": "d", "✗": "e" };
  return esc(line)
    .replace(/\b\d+(?:\.\d+)?(?:KB|MB|GB|TB|B|s)?(?:\/s)?(?![\w-])/g, (n) => `<span class="k">${n}</span>`)
    .replace(/^(\s*)([✓⚠✗])/, (_, indent, mark) => `${indent}<span class="${marks[mark]}">${mark}</span>`);
}

/** A line of YAML: comments, section names, keys, strings and literals. */
function yaml(line: string): string {
  if (/^\s*#/.test(line)) return span("cm", line);
  const pair = line.match(/^(\s*)([\w-]+)(:)(?: (.*))?$/);
  if (!pair) return esc(line);
  const [, indent, key, colon, value] = pair;
  const shown = value === undefined ? "" : " " + span(value.startsWith('"') ? "js" : "jb", value);
  return indent + span(indent ? "k" : "jk", key) + span("jp", colon) + shown;
}

const config = `source:
  endpoint_url: "https://s3.source.example.com"
  aws_access_key_id: "SOURCE_ACCESS_KEY"
  aws_secret_access_key: "SOURCE_SECRET_KEY"
  verify_ssl: true

destination:
  endpoint_url: "https://s3.destination.example.com"
  aws_access_key_id: "DEST_ACCESS_KEY"
  aws_secret_access_key: "DEST_SECRET_KEY"
  verify_ssl: true`;
const run = ["s3mirror --config config.yaml --no-delete"];
const bucketSection = `======================================================================
[1/2]: app-data
======================================================================
  Source: 4 objects
  Destination: 3 objects
  Actions: 3 to copy (100.8KB), 0 to delete
  ✓ Copied 3 objects in 0.0s (39.8MB/s)
  ✓ Bucket completed in 0.0s`;
const image = `${links.image}:${release.tagged ? release.version : "latest"}`;
const scheduled = ["s3mirror --config /etc/s3mirror.yaml \\", "    --log-file /var/log/s3mirror.log"];
const container = [
  "docker run --rm \\",
  "    -v /etc/s3mirror.yaml:/config/config.yaml:ro \\",
  "    -v /var/log/s3mirror:/logs \\",
  `    ${image} \\`,
  "    --config /config/config.yaml --log-file /logs/s3mirror.log",
];

const tabs = [
  {
    id: "run",
    label: "Copy-only run",
    copy: join(run),
    lines: [
      ...commandLines(run),
      "",
      span("cm", "# after the connection checks, one section per bucket:"),
      ...bucketSection.split("\n").map(output),
      "",
      span("cm", "# and the summary ends with"),
      output("✓ Status: COMPLETED SUCCESSFULLY"),
    ],
  },
  {
    id: "config",
    label: "Config",
    copy: config,
    lines: [span("cm", "# config.yaml"), ...config.split("\n").map(yaml)],
  },
  {
    id: "scheduled",
    label: "Scheduled run",
    copy: `${join(scheduled)}\n\n${join(container)}`,
    lines: [
      span("cm", "# from cron or a systemd timer: the full log goes to the file,"),
      span("cm", "# and only errors reach the console"),
      ...commandLines(scheduled),
      "",
      span("cm", "# the same run from the container image"),
      ...commandLines(container),
      "",
      span("cm", "# exit code 0 means no errors were counted; alert on anything else"),
    ],
  },
];
const install = "brew tap netspeedy/s3mirror && brew install s3mirror";
const copyIcon =
  '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>';
---

<section class="ns-home-top not-content">
  <div class="ns-home-copy">
    <p class="ns-home-label">{product.name} documentation{release.tagged && ` · ${release.version}`}</p>
    <h1 id="_top">{lines.map((line, i) => (i ? [<br />, line] : line))}</h1>
    <div class="ns-home-lead"><slot /></div>
    <div class="ns-home-actions">
      <a class="ns-button ns-button-primary" href={`${import.meta.env.BASE_URL}quickstart/`}>
        Read the quickstart
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
      <a class="ns-button" href={`${import.meta.env.BASE_URL}how-it-works/`}>How mirroring works</a>
    </div>
    <ns-copy class="ns-home-install" data-copy={install}>
      <code><span class="ns-prompt">$ </span>{install}</code>
      <button type="button" aria-label="Copy the install commands" set:html={copyIcon} />
    </ns-copy>
  </div>

  <ns-code-tabs class="ns-panel">
    <div class="ns-panel-head">
      <div role="tablist" aria-label="Examples">
        {
          tabs.map((tab, i) => (
            <button
              type="button"
              role="tab"
              id={`ns-tab-${tab.id}`}
              aria-controls={`ns-panel-${tab.id}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
            >
              {tab.label}
            </button>
          ))
        }
      </div>
      <button type="button" class="ns-panel-copy" aria-label="Copy the command" set:html={copyIcon} />
    </div>
    {
      tabs.map((tab, i) => (
        <div
          class="ns-panel-body"
          role="tabpanel"
          id={`ns-panel-${tab.id}`}
          aria-labelledby={`ns-tab-${tab.id}`}
          data-copy={tab.copy}
          hidden={i !== 0}
          tabindex="0"
        >
          <pre set:html={tab.lines.join("\n")} />
        </div>
      ))
    }
  </ns-code-tabs>
</section>

<script>
  async function copy(text: string, button: HTMLElement) {
    try {
      await navigator.clipboard.writeText(text);
      button.dataset.copied = "";
      setTimeout(() => delete button.dataset.copied, 1600);
    } catch {
      // No clipboard access (an insecure origin or a refused permission): leave the text to select.
    }
  }

  class CopyText extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector("button");
      button?.addEventListener("click", () => copy(this.dataset.copy ?? "", button));
    }
  }

  class CodeTabs extends HTMLElement {
    connectedCallback() {
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const select = (chosen: HTMLButtonElement) => {
        for (const tab of tabs) {
          const on = tab === chosen;
          tab.setAttribute("aria-selected", String(on));
          tab.tabIndex = on ? 0 : -1;
          const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");
          if (panel) panel.hidden = !on;
        }
      };
      tabs.forEach((tab, i) => {
        tab.addEventListener("click", () => select(tab));
        tab.addEventListener("keydown", (event) => {
          const step = event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
          if (!step) return;
          const next = tabs[(i + step + tabs.length) % tabs.length];
          select(next);
          next.focus();
        });
      });
      const copyButton = this.querySelector<HTMLButtonElement>(".ns-panel-copy");
      copyButton?.addEventListener("click", () => {
        const panel = this.querySelector<HTMLElement>('[role="tabpanel"]:not([hidden])');
        if (panel) copy(panel.dataset.copy ?? "", copyButton);
      });
    }
  }

  customElements.define("ns-copy", CopyText);
  customElements.define("ns-code-tabs", CodeTabs);
</script>

<style>
  .ns-home-top {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 3.5rem;
    align-items: center;
    padding: 2.5rem 0 4rem;
  }
  .ns-home-label {
    margin: 0;
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  h1 {
    margin: 0.875rem 0 0;
    font-size: clamp(2.125rem, 1.4rem + 2.2vw, 2.875rem);
    line-height: 1.06;
    font-weight: 700;
    letter-spacing: -0.038em;
    color: var(--sl-color-white);
  }
  .ns-home-lead {
    max-width: 32.5rem;
    margin-top: 1.25rem;
    font-size: var(--sl-text-lg);
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }
  .ns-home-lead :global(p) {
    margin: 0;
  }
  .ns-home-lead :global(code) {
    padding: 0.0625rem 0.3125rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 5px;
    background-color: var(--sl-color-gray-7);
    font-size: 0.84em;
    color: var(--sl-color-white);
    white-space: nowrap;
  }
  .ns-home-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-top: 1.875rem;
  }
  .ns-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 1.125rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 9px;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .ns-button:hover {
    border-color: var(--sl-color-gray-3);
  }
  .ns-button svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ns-button-primary {
    border-color: var(--sl-color-white);
    background-color: var(--sl-color-white);
    color: var(--sl-color-black);
  }
  .ns-button-primary:hover {
    border-color: var(--sl-color-gray-1);
    background-color: var(--sl-color-gray-1);
  }
  .ns-home-install {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
  }
  .ns-home-install code {
    font-family: var(--__sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .ns-prompt {
    color: var(--sl-color-gray-3);
  }
  button {
    font: inherit;
    cursor: pointer;
  }
  .ns-home-install button,
  .ns-panel-copy {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: 7px;
    background: none;
    color: var(--sl-color-gray-3);
  }
  .ns-home-install button:hover {
    color: var(--sl-color-white);
  }
  .ns-home-install button :global(svg),
  .ns-panel-copy :global(svg) {
    width: 0.9375rem;
    height: 0.9375rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linejoin: round;
  }
  [data-copied] {
    color: var(--ns-ok) !important;
  }

  /* The panel is dark in both themes, like every code block on the site. */
  .ns-panel {
    display: block;
    min-width: 0;
    border: 1px solid #1c2330;
    border-radius: 14px;
    background-color: #0b0f16;
    box-shadow: 0 30px 60px -30px rgb(11 18 32 / 0.45);
    overflow: hidden;
    color: #dce4ee;
  }
  :global([data-theme="dark"]) .ns-panel {
    box-shadow: none;
  }
  .ns-panel-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 0.375rem;
    border-bottom: 1px solid #1c2330;
    background-color: #0f141d;
  }
  [role="tablist"] {
    display: flex;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }
  [role="tab"] {
    padding: 0.75rem 0.75rem 0.625rem;
    border: 0;
    border-bottom: 2px solid transparent;
    background: none;
    font-size: var(--sl-text-xs);
    color: #8f9bab;
    white-space: nowrap;
  }
  [role="tab"]:hover {
    color: #e8ecf1;
  }
  [role="tab"][aria-selected="true"] {
    border-bottom-color: #4bd8ff;
    font-weight: 500;
    color: #e8ecf1;
  }
  .ns-panel-copy {
    flex: 0 0 auto;
    color: #8f9bab;
  }
  .ns-panel-copy:hover {
    color: #e8ecf1;
  }
  .ns-panel-body {
    overflow-x: auto;
  }
  .ns-panel-body:focus-visible {
    outline: 2px solid #4bd8ff;
    outline-offset: -2px;
  }
  pre {
    margin: 0;
    padding: 1rem 1.125rem 1.25rem;
    font-family: var(--__sl-font-mono);
    font-size: 0.8125rem;
    line-height: 1.75;
  }
  pre :global(.p) {
    color: #f5b841;
  }
  pre :global(.c),
  pre :global(.h) {
    color: #ffffff;
    font-weight: 600;
  }
  pre :global(.f) {
    color: #7fe3ff;
  }
  pre :global(.v) {
    color: #fde1a7;
  }
  pre :global(.m),
  pre :global(.jp) {
    color: #7d8999;
  }
  pre :global(.k) {
    color: #a8ecff;
  }
  pre :global(.y) {
    color: #3cd788;
  }
  /* A rule of = signs: muted, and cut off at the panel's edge instead of widening it. */
  pre :global(.rule) {
    display: inline-block;
    width: 100%;
    overflow: hidden;
    vertical-align: top;
    color: #7d8999;
  }
  pre :global(.e) {
    color: #ff5d6c;
  }
  pre :global(.d),
  pre :global(.jb) {
    color: #f5b841;
  }
  pre :global(.g),
  pre :global(.cm) {
    color: #6b7686;
    font-style: italic;
  }
  pre :global(.jk) {
    color: #a5b1ff;
  }
  pre :global(.js),
  pre :global(.u) {
    color: #6fd8a5;
  }

  @media (max-width: 56rem) {
    .ns-home-top {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.25rem;
      padding: 1rem 0 3.5rem;
    }
  }
</style>
